# ── Skyhigh Cloud SSE ────────────────────────────────────────────────────────
# Tenant ID (shown in Skyhigh console under Account > Tenant)
SHN_TENANT_ID=your-tenant-id

# Admin credentials for the Skyhigh SSE console
SHN_USERNAME=admin@yourcompany.com
SHN_PASSWORD=your-password

# Region: us | eu | ca | gov
SHN_REGION=us

# ── Skyhigh SWG On-Premises (only needed for fetch-onprem command) ─────────
SHN_ONPREM_HOST=10.0.0.1
SHN_ONPREM_PORT=4711
SHN_ONPREM_USERNAME=admin
SHN_ONPREM_PASSWORD=your-password
SHN_ONPREM_SSL=false

# ── Zscaler ZIA ───────────────────────────────────────────────────────────────
# Cloud name — find yours at help.zscaler.com/zia/identifying-your-zscaler-cloud
# Examples: zscaler.net  zscalerone.net  zscalertwo.net  zscloud.net
ZIA_CLOUD=zscaler.net

# ZIA admin credentials
ZIA_USERNAME=admin@yourcompany.com
ZIA_PASSWORD=your-password

# Raw (non-obfuscated) API key from ZIA admin portal:
#   Administration > API Key Management
ZIA_API_KEY=your-raw-api-key

# ── Zscaler ZPA (only needed if migrating CWPP/private-access policies) ────
ZPA_CLIENT_ID=your-zpa-client-id
ZPA_CLIENT_SECRET=your-zpa-client-secret
ZPA_CUSTOMER_ID=your-zpa-customer-id
ZPA_CLOUD=config.private.zscaler.com
